@model Hal_Taalam.ViewModel.Player.ProfileVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@localizer["PlayerProfile"] - Hal Taalam</title>
    <link rel="stylesheet" href="~/css/Profile.css" asp-append-version="true">
</head>
<body>
    <div class="profile-container">
        <div class="profile-card">
            <div class="profile-header">
                <div class="profile-logo">
                    <img src="~/Image/logo.jpg" alt="Hal Taalam Logo" />
                </div>
                <h1>@localizer["PlayerProfileTitle"]</h1>
                <p>@localizer["CompleteProfile"]</p>
            </div>

            <form asp-action="Profile" method="post" class="profile-form">
                <div asp-validation-summary="All" class="validation-summary"></div>

                <div class="form-group">
                    <label asp-for="Name" class="form-label">
                        <i class="icon">👤</i>
                        @localizer["PlayerName"]
                    </label>
                    <input asp-for="Name" class="form-input" placeholder="@localizer["EnterPlayerName"].Value" />
                    <span asp-validation-for="Name" class="field-validation"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Age" class="form-label">
                        <i class="icon">🎂</i>
                        @localizer["Age"]
                    </label>
                    <input asp-for="Age" class="form-input" placeholder="@localizer["EnterAge"].Value" />
                    <span asp-validation-for="Age" class="field-validation"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn-submit">
                        <span>@localizer["SaveProfile"]</span>
                        <i class="btn-icon">💾</i>
                    </button>
                </div>
            </form>

            <div class="profile-footer">
                <div class="back-link">
                    <a asp-action="Index">← @localizer["BackToList"]</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/Profile.js" asp-append-version="true"></script>
</body>
</html>
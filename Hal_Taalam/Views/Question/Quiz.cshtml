@model Hal_Taalam.ViewModel.Questions.QuizVM
@{
    ViewData["Title"] = "Quiz";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Quiz.css" asp-append-version="true">
}

<div class="quiz-container">
    <!-- Progress Section -->
    <div class="quiz-progress">
        <div class="progress-bar">
            <div class="progress-fill" id="progressFill" style="width: @(((Model.index + 1) * 100.0 / Model.total))%"></div>
        </div>
        <div class="progress-text">
            <span class="current-question">Question <span id="currentQuestion">@(Model.index + 1)</span></span>
            <span class="total-questions">of @Model.total</span>
        </div>
    </div>

    <!-- Question Card -->
    <div class="question-card">
        <div class="question-header">
            <div class="question-icon">❓</div>
            <h2 class="question-text" id="questionText">@Model.QuestionVM.question</h2>
        </div>

        <!-- Answers Form -->
        <form asp-controller="Question" asp-action="Answer" method="post" id="quizForm">
            <input type="hidden" asp-for="index" id="questionIndex" />

            <div class="answers-grid">
                <div class="answer-option" data-answer="1">
                    <input type="radio" id="answer1" name="selectedAnswer" value="1" class="answer-radio" />
                    <label for="answer1" class="answer-label">
                        <span class="answer-letter">A</span>
                        <span class="answer-text">@Model.QuestionVM.answer1</span>
                        <span class="answer-check">✓</span>
                    </label>
                </div>

                <div class="answer-option" data-answer="2">
                    <input type="radio" id="answer2" name="selectedAnswer" value="2" class="answer-radio" />
                    <label for="answer2" class="answer-label">
                        <span class="answer-letter">B</span>
                        <span class="answer-text">@Model.QuestionVM.answer2</span>
                        <span class="answer-check">✓</span>
                    </label>
                </div>

                <div class="answer-option" data-answer="3">
                    <input type="radio" id="answer3" name="selectedAnswer" value="3" class="answer-radio" />
                    <label for="answer3" class="answer-label">
                        <span class="answer-letter">C</span>
                        <span class="answer-text">@Model.QuestionVM.answer3</span>
                        <span class="answer-check">✓</span>
                    </label>
                </div>

                <div class="answer-option" data-answer="4">
                    <input type="radio" id="answer4" name="selectedAnswer" value="4" class="answer-radio" />
                    <label for="answer4" class="answer-label">
                        <span class="answer-letter">D</span>
                        <span class="answer-text">@Model.QuestionVM.answer4</span>
                        <span class="answer-check">✓</span>
                    </label>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="quiz-actions">
                <button type="submit" class="btn-next" id="btnNext" disabled>
                    <span>Next Question</span>
                    <span class="btn-arrow">→</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/Quiz.js" asp-append-version="true"></script>
}

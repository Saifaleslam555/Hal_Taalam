@model Question

@{
    ViewData["Title"] = localizer["AnswerTheQuestion"].Value;
}

<div class="container mt-5">
    <h2 class="text-center mb-4">@localizer["AnswerTheQuestion"]</h2>

    <form asp-controller="Question" asp-action="StartQuiz" method="post">
        <input type="hidden" name="QuestionId" value="@Model.Id" />

        <div class="card shadow-lg p-4">
            <div class="question-text mb-4">
                <h4>@Model.question</h4>
            </div>

            <div class="options mb-4">
                <div class="form-check">
                    <input asp-for="Answer1" class="form-check-input" type="radio" name="selectedAnswer" value="1" id="opt1" />
                    <label class="form-check-label" for="opt1">
                        @Model.Answer1
                    </label>
                </div>

                <div class="form-check">
                    <input asp-for="Answer2" class="form-check-input" type="radio" name="selectedAnswer" value="2" id="opt2" />
                    <label class="form-check-label" for="opt2">
                        @Model.Answer2
                    </label>
                </div>

                <div class="form-check">
                    <input asp-for="Answer3" class="form-check-input" type="radio" name="selectedAnswer" value="3" id="opt3" />
                    <label class="form-check-label" for="opt3">
                        @Model.Answer3
                    </label>
                </div>

                <div class="form-check">
                    <input asp-for="Answer4" class="form-check-input" type="radio" name="selectedAnswer" value="4" id="opt4" />
                    <label class="form-check-label" for="opt4">
                        @Model.Answer4
                    </label>
                </div>
            </div>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <button type="submit" class="btn btn-primary w-100">@localizer["SubmitAnswer"]</button>
        </div>
    </form>
</div>
@model Hal_Taalam.ViewModel.Account.RegeisterVM
@{
    ViewData["Title"] = localizer["Register"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Auth.css" asp-append-version="true">
}

<div class="auth-container">
    <div class="auth-card register-card">
        <div class="auth-header">
            <div class="auth-logo">
                <img src="~/Image/logo.jpg" alt="Hal Taalam Logo" />
            </div>
            <h1>@localizer["JoinAdventureTitle"]</h1>
            <p>@localizer["JoinAdventureSub"]</p>
        </div>

        <form asp-action="Register" method="post" class="auth-form" asp-controller="Account">
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="UserName" class="form-label">
                    <i class="icon">👤</i>
                    @localizer["Username"]
                </label>
                <input asp-for="UserName" class="form-input" placeholder="@localizer["ChooseUsername"].Value" />
                <span asp-validation-for="UserName" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">
                    <i class="icon">📧</i>
                    @localizer["EmailAddress"]
                </label>
                <input asp-for="Email" class="form-input" placeholder="@localizer["EnterEmail"].Value" />
                <span asp-validation-for="Email" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">
                    <i class="icon">🔒</i>
                    @localizer["Password"]
                </label>
                <input asp-for="Password" class="form-input" placeholder="@localizer["CreatePassword"].Value" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="conformidPassword" class="form-label">
                    <i class="icon">🔒</i>
                    @localizer["ConfirmPassword"]
                </label>
                <input asp-for="conformidPassword" class="form-input" placeholder="@localizer["ConfirmYourPassword"].Value" />
                <span asp-validation-for="conformidPassword" class="field-validation"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn-submit">
                    <span>@localizer["CreateAccount"]</span>
                    <i class="btn-icon">🚀</i>
                </button>
            </div>
        </form>

        <div class="auth-footer">
            <p>@localizer["AlreadyHaveAccount"]</p>
            <a asp-action="Login" class="switch-auth" asp-controller="Account">@localizer["LoginHere"]</a>
            <div class="back-link">
                <a asp-controller="Home" asp-action="StartPage">← @localizer["BackToStart"]</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Auth.js" asp-append-version="true"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
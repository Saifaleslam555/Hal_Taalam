@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@{
    ViewData["Title"] = "Admin Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true">
}

<div class="dashboard-container">
    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="dashboard-title">Admin Dashboard</h1>
            <p class="dashboard-subtitle">لوحة التحكم</p>
        </div>
        <div class="header-actions">
            <button class="btn-header" id="refreshBtn">
                <span class="btn-icon">🔄</span>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-grid">
        <div class="stat-card stat-primary">
            <div class="stat-icon">👥</div>
            <div class="stat-content">
                <h3 class="stat-value">1,234</h3>
                <p class="stat-label">Total Users</p>
                <span class="stat-change positive">+12% this month</span>
            </div>
        </div>

        <div class="stat-card stat-success">
            <div class="stat-icon">📝</div>
            <div class="stat-content">
                <h3 class="stat-value">5,678</h3>
                <p class="stat-label">Total Questions</p>
                <span class="stat-change positive">+8% this month</span>
            </div>
        </div>

        <div class="stat-card stat-warning">
            <div class="stat-icon">🎮</div>
            <div class="stat-content">
                <h3 class="stat-value">23,456</h3>
                <p class="stat-label">Games Played</p>
                <span class="stat-change positive">+15% this month</span>
            </div>
        </div>

        <div class="stat-card stat-info">
            <div class="stat-icon">📊</div>
            <div class="stat-content">
                <h3 class="stat-value">87%</h3>
                <p class="stat-label">Avg. Score</p>
                <span class="stat-change negative">-2% this month</span>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="content-grid">
        <!-- Quick Actions -->
        <div class="dashboard-card quick-actions-card">
            <div class="card-header">
                <h2 class="card-title">Quick Actions</h2>
                <p class="card-subtitle">إجراءات سريعة</p>
            </div>
            <div class="card-body">
                <div class="actions-grid">
                    <a asp-controller="Admin" asp-action="AddQuestion" class="action-btn">
                        <span class="action-icon">➕</span>
                        <span class="action-text">Add Question</span>
                    </a>
                    <a asp-controller="Admin" asp-action="Users" class="action-btn">
                        <span class="action-icon">👤</span>
                        <span class="action-text">Manage Users</span>
                    </a>
                    <a asp-controller="Admin" asp-action="Categories" class="action-btn">
                        <span class="action-icon">📂</span>
                        <span class="action-text">Categories</span>
                    </a>
                    <a asp-controller="Admin" asp-action="Reports" class="action-btn">
                        <span class="action-icon">📈</span>
                        <span class="action-text">View Reports</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="dashboard-card activity-card">
            <div class="card-header">
                <h2 class="card-title">Recent Activity</h2>
                <p class="card-subtitle">النشاط الأخير</p>
            </div>
            <div class="card-body">
                <div class="activity-list">
                    <div class="activity-item">
                        <div class="activity-icon new">🆕</div>
                        <div class="activity-content">
                            <p class="activity-text">New user registered: <strong>Ahmed</strong></p>
                            <span class="activity-time">5 minutes ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon update">📝</div>
                        <div class="activity-content">
                            <p class="activity-text">Question updated in <strong>Science</strong></p>
                            <span class="activity-time">15 minutes ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon complete">✅</div>
                        <div class="activity-content">
                            <p class="activity-text">Quiz completed by <strong>Sara</strong></p>
                            <span class="activity-time">1 hour ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon warning">⚠️</div>
                        <div class="activity-content">
                            <p class="activity-text">Question reported: <strong>ID #123</strong></p>
                            <span class="activity-time">2 hours ago</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Categories -->
        <div class="dashboard-card categories-card">
            <div class="card-header">
                <h2 class="card-title">Top Categories</h2>
                <p class="card-subtitle">الفئات الأكثر شعبية</p>
            </div>
            <div class="card-body">
                <div class="category-list">
                    <div class="category-item">
                        <div class="category-info">
                            <span class="category-name">Science</span>
                            <span class="category-count">456 questions</span>
                        </div>
                        <div class="category-bar">
                            <div class="category-progress" style="width: 85%"></div>
                        </div>
                    </div>
                    <div class="category-item">
                        <div class="category-info">
                            <span class="category-name">Math</span>
                            <span class="category-count">389 questions</span>
                        </div>
                        <div class="category-bar">
                            <div class="category-progress" style="width: 70%"></div>
                        </div>
                    </div>
                    <div class="category-item">
                        <div class="category-info">
                            <span class="category-name">History</span>
                            <span class="category-count">312 questions</span>
                        </div>
                        <div class="category-bar">
                            <div class="category-progress" style="width: 60%"></div>
                        </div>
                    </div>
                    <div class="category-item">
                        <div class="category-info">
                            <span class="category-name">Geography</span>
                            <span class="category-count">278 questions</span>
                        </div>
                        <div class="category-bar">
                            <div class="category-progress" style="width: 50%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- System Status -->
        <div class="dashboard-card status-card">
            <div class="card-header">
                <h2 class="card-title">System Status</h2>
                <p class="card-subtitle">حالة النظام</p>
            </div>
            <div class="card-body">
                <div class="status-list">
                    <div class="status-item">
                        <div class="status-indicator online"></div>
                        <span class="status-label">Database</span>
                        <span class="status-value">Online</span>
                    </div>
                    <div class="status-item">
                        <div class="status-indicator online"></div>
                        <span class="status-label">Server</span>
                        <span class="status-value">Healthy</span>
                    </div>
                    <div class="status-item">
                        <div class="status-indicator warning"></div>
                        <span class="status-label">Storage</span>
                        <span class="status-value">75% Used</span>
                    </div>
                    <div class="status-item">
                        <div class="status-indicator online"></div>
                        <span class="status-label">API</span>
                        <span class="status-value">Active</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Management Tables Section -->
    <div class="tables-section">
        <div class="dashboard-card table-card">
            <div class="card-header">
                <h2 class="card-title">Recent Users</h2>
                <a asp-controller="Admin" asp-action="Users" class="view-all-link">View All →</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Level</th>
                                <th>Games</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="user-info">
                                        <div class="user-avatar">A</div>
                                        <span>Ahmed Salem</span>
                                    </div>
                                </td>
                                <td>ahmed@example.com</td>
                                <td><span class="badge badge-primary">Level 5</span></td>
                                <td>23</td>
                                <td><span class="badge badge-success">Active</span></td>
                                <td>
                                    <button class="table-action-btn">👁️</button>
                                    <button class="table-action-btn">✏️</button>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="user-info">
                                        <div class="user-avatar">S</div>
                                        <span>Sara Ali</span>
                                    </div>
                                </td>
                                <td>sara@example.com</td>
                                <td><span class="badge badge-primary">Level 3</span></td>
                                <td>15</td>
                                <td><span class="badge badge-success">Active</span></td>
                                <td>
                                    <button class="table-action-btn">👁️</button>
                                    <button class="table-action-btn">✏️</button>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="user-info">
                                        <div class="user-avatar">M</div>
                                        <span>Mohamed Hassan</span>
                                    </div>
                                </td>
                                <td>mohamed@example.com</td>
                                <td><span class="badge badge-primary">Level 7</span></td>
                                <td>45</td>
                                <td><span class="badge badge-warning">Inactive</span></td>
                                <td>
                                    <button class="table-action-btn">👁️</button>
                                    <button class="table-action-btn">✏️</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/AdminDashboard.js" asp-append-version="true"></script>
}
@model Hal_Taalam.ViewModel.Admin.AdminDashboardVM

@{
    ViewData["Title"] = localizer["AdminDashboard"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true">
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="dashboard-title">@localizer["AdminDashboard"]</h1>
            <p class="dashboard-subtitle">@localizer["ControlPanel"]</p>
        </div>
        <div class="header-actions">
            <button class="btn-header" id="refreshBtn">
                <span class="btn-icon">🔄</span>
                <span>@localizer["Refresh"]</span>
            </button>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card stat-primary">
            <div class="stat-icon">👥</div>
            <div class="stat-content">
                <h3 class="stat-value">@Model.PlayersCount</h3>
                <p class="stat-label">@localizer["TotalUsers"]</p>
                <span class="stat-change positive">@localizer["ActivePlayers"]</span>
            </div>
        </div>

        <div class="stat-card stat-success" onclick="window.location.href='@Url.Action("QuestionList", "Admin")'" style="cursor: pointer;" title="عرض وإدارة الأسئلة">
            <div class="stat-icon">📝</div>
            <div class="stat-content">
                <h3 class="stat-value">@Model.QuestionsCount</h3>
                <p class="stat-label">@localizer["TotalQuestions"]</p>
                <span class="stat-change positive">@localizer["InDatabase"]</span>
            </div>
        </div>

        <div class="stat-card stat-warning">
            <div class="stat-icon">🎮</div>
            <div class="stat-content">
                <h3 class="stat-value">@Model.GamesCount</h3>
                <p class="stat-label">@localizer["GamesPlayed"]</p>
                <span class="stat-change positive">@localizer["TotalResults"]</span>
            </div>
        </div>

        <div class="stat-card stat-info">
            <div class="stat-icon">📂</div>
            <div class="stat-content">
                <h3 class="stat-value">@Model.CategoriesCount</h3>
                <p class="stat-label">@localizer["TotalCategories"]</p>
                <span class="stat-change positive">@localizer["AvailableSections"]</span>
            </div>
        </div>
    </div>

    <div class="content-grid">
        <div class="dashboard-card quick-actions-card">
            <div class="card-header">
                <h2 class="card-title">@localizer["QuickActions"]</h2>
                <p class="card-subtitle">@localizer["QuickActionsSub"]</p>
            </div>
            <div class="card-body">
                <div class="actions-grid">
                    <a asp-controller="Admin" asp-action="AddQuestion" class="action-btn">
                        <span class="action-icon">➕</span>
                        <span class="action-text">@localizer["AddQuestionAction"]</span>
                    </a>

                    <a asp-controller="Admin" asp-action="QuestionList" class="action-btn">
                        <span class="action-icon">📝</span>
                        <span class="action-text">@localizer["ManageQuestions"]</span>
                    </a>

                    <a asp-controller="Admin" asp-action="Users" class="action-btn">
                        <span class="action-icon">👤</span>
                        <span class="action-text">@localizer["ManageUsers"]</span>
                    </a>
                    <a asp-controller="Admin" asp-action="Reports" class="action-btn">
                        <span class="action-icon">📈</span>
                        <span class="action-text">@localizer["ViewReports"]</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="dashboard-card status-card">
            <div class="card-header">
                <h2 class="card-title">@localizer["SystemStatus"]</h2>
                <p class="card-subtitle">@localizer["SystemStatusSub"]</p>
            </div>
            <div class="card-body">
                <div class="status-list">
                    <div class="status-item">
                        <div class="status-indicator @(Model.IsDatabaseOnline ? "online" : "warning")"></div>
                        <span class="status-label">@localizer["Database"]</span>
                        <span class="status-value">@(Model.IsDatabaseOnline ? localizer["Online"].Value : localizer["Offline"].Value)</span>
                    </div>
                    <div class="status-item">
                        <div class="status-indicator online"></div>
                        <span class="status-label">@localizer["Server"]</span>
                        <span class="status-value">@localizer["Healthy"]</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tables-section">
        <div class="dashboard-card table-card">
            <div class="card-header">
                <h2 class="card-title">@localizer["RecentUsers"]</h2>
                <a asp-controller="Admin" asp-action="Users" class="view-all-link">@localizer["ViewAll"] →</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@localizer["Name"]</th>
                                <th>@localizer["Email"]</th>
                                <th>@localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentPlayers != null && Model.RecentPlayers.Any())
                            {
                                foreach (var player in Model.RecentPlayers)
                                {
                                    <tr>
                                        <td>
                                            <div class="user-info">
                                                <div class="user-avatar">
                                                    @(string.IsNullOrEmpty(player.Name) ? "U" : player.Name.Substring(0, 1).ToUpper())
                                                </div>
                                                <span>@player.Name</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" style="text-align: center;">@localizer["NoPlayersAvailable"]</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/AdminDashboard.js" asp-append-version="true"></script>
}
@* تعريف الـ ViewModel الخاص بالصفحة *@
@model Hal_Taalam.ViewModel.Admin.AdminDashboardVM

@{
    ViewData["Title"] = "Admin Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true">
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="dashboard-title">Admin Dashboard</h1>
            <p class="dashboard-subtitle">لوحة التحكم</p>
        </div>
        <div class="header-actions">
            <button class="btn-header" id="refreshBtn">
                <span class="btn-icon">🔄</span>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card stat-primary">
            <div class="stat-icon">👥</div>
            <div class="stat-content">
                <h3 class="stat-value">@Model.PlayersCount</h3>
                <p class="stat-label">Total Users</p>
                <span class="stat-change positive">Active Players</span>
            </div>
        </div>

        <div class="stat-card stat-success" onclick="window.location.href='@Url.Action("QuestionList", "Admin")'" style="cursor: pointer;" title="عرض وإدارة الأسئلة">
            <div class="stat-icon">📝</div>
            <div class="stat-content">
                <h3 class="stat-value">@Model.QuestionsCount</h3>
                <p class="stat-label">Total Questions</p>
                <span class="stat-change positive">In Database</span>
            </div>
        </div>

        <div class="stat-card stat-warning">
            <div class="stat-icon">🎮</div>
            <div class="stat-content">
                <h3 class="stat-value">@Model.GamesCount</h3>
                <p class="stat-label">Games Played</p>
                <span class="stat-change positive">Total Results</span>
            </div>
        </div>

        <div class="stat-card stat-info">
            <div class="stat-icon">📂</div>
            <div class="stat-content">
                <h3 class="stat-value">@Model.CategoriesCount</h3>
                <p class="stat-label">Total Categories</p>
                <span class="stat-change positive">Available Sections</span>
            </div>
        </div>
    </div>

    <div class="content-grid">
        <div class="dashboard-card quick-actions-card">
            <div class="card-header">
                <h2 class="card-title">Quick Actions</h2>
                <p class="card-subtitle">إجراءات سريعة</p>
            </div>
            <div class="card-body">
                <div class="actions-grid">
                    <a asp-controller="Admin" asp-action="AddQuestion" class="action-btn">
                        <span class="action-icon">➕</span>
                        <span class="action-text">Add Question</span>
                    </a>

                    <a asp-controller="Admin" asp-action="QuestionList" class="action-btn">
                        <span class="action-icon">📝</span>
                        <span class="action-text">Manage Questions</span>
                    </a>

                    <a asp-controller="Admin" asp-action="Users" class="action-btn">
                        <span class="action-icon">👤</span>
                        <span class="action-text">Manage Users</span>
                    </a>
                    <a asp-controller="Admin" asp-action="Categories" class="action-btn">
                        <span class="action-icon">📂</span>
                        <span class="action-text">Categories</span>
                    </a>
                    <a asp-controller="Admin" asp-action="Reports" class="action-btn">
                        <span class="action-icon">📈</span>
                        <span class="action-text">View Reports</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="dashboard-card status-card">
            <div class="card-header">
                <h2 class="card-title">System Status</h2>
                <p class="card-subtitle">حالة النظام</p>
            </div>
            <div class="card-body">
                <div class="status-list">
                    <div class="status-item">
                        <div class="status-indicator @(Model.IsDatabaseOnline ? "online" : "warning")"></div>
                        <span class="status-label">Database</span>
                        <span class="status-value">@(Model.IsDatabaseOnline ? "Online" : "Offline")</span>
                    </div>
                    <div class="status-item">
                        <div class="status-indicator online"></div>
                        <span class="status-label">Server</span>
                        <span class="status-value">Healthy</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tables-section">
        <div class="dashboard-card table-card">
            <div class="card-header">
                <h2 class="card-title">Recent Users</h2>
                <a asp-controller="Admin" asp-action="Users" class="view-all-link">View All →</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentPlayers != null && Model.RecentPlayers.Any())
                            {
                                foreach (var player in Model.RecentPlayers)
                                {
                                    <tr>
                                        <td>
                                            <div class="user-info">
                                                <div class="user-avatar">
                                                    @(string.IsNullOrEmpty(player.Name) ? "U" : player.Name.Substring(0, 1).ToUpper())
                                                </div>
                                                <span>@player.Name</span>
                                            </div>
                                        </td>
                                        @* <td>@player.Email</td>
                                        <td>
                                            <button class="table-action-btn">👁️</button>
                                            <button class="table-action-btn">✏️</button>
                                        </td> *@
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" style="text-align: center;">لا يوجد لاعبين متاحين حالياً.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/AdminDashboard.js" asp-append-version="true"></script>
}
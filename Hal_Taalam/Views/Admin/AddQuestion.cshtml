@model Hal_Taalam.ViewModel.Admin.CreateQuestionVM

@{
    var routeId = ViewContext.RouteData.Values["id"];
    bool isEditMode = routeId != null;

    ViewData["Title"] = isEditMode ? localizer["EditQuestion"].Value : localizer["AddNewQuestion"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/AdminQuestions.css" asp-append-version="true">
}

<div class="questions-container">
    <div class="admin-card">
        <div class="card-header-flex">
            <h2 class="card-title">@(isEditMode ? localizer["EditQuestion"].Value : localizer["AddNewQuestion"].Value)</h2>
            <a asp-action="QuestionList" class="btn btn-outline">⬅️ @localizer["BackToList"]</a>
        </div>

        <form asp-controller="Admin" asp-action="@(isEditMode ? "UpdateQuestion" : "CreationQuestion")" method="post">

            @if (isEditMode)
            {
                <input type="hidden" name="QuestionId" value="@routeId" />
            }

            <div class="form-group">
                <label class="form-label">@localizer["QuestionText"]</label>
                <textarea asp-for="Question" class="form-control" rows="3" placeholder="@localizer["WriteQuestionHere"].Value" required></textarea>
            </div>

            <div class="form-row">
                <div class="form-col">
                    <div class="form-group">
                        <label class="form-label">@localizer["Answer1"]</label>
                        <input asp-for="Answer1" class="form-control" placeholder="@localizer["FirstAnswer"].Value" required />
                    </div>
                </div>
                <div class="form-col">
                    <div class="form-group">
                        <label class="form-label">@localizer["Answer2"]</label>
                        <input asp-for="Answer2" class="form-control" placeholder="@localizer["SecondAnswer"].Value" required />
                    </div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-col">
                    <div class="form-group">
                        <label class="form-label">@localizer["Answer3"]</label>
                        <input asp-for="Answer3" class="form-control" placeholder="@localizer["ThirdAnswer"].Value" required />
                    </div>
                </div>
                <div class="form-col">
                    <div class="form-group">
                        <label class="form-label">@localizer["Answer4"]</label>
                        <input asp-for="Answer4" class="form-control" placeholder="@localizer["FourthAnswer"].Value" required />
                    </div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-col">
                    <div class="form-group">
                        <label class="form-label">@localizer["CorrectAnswer"]</label>
                        <select asp-for="CorrectAnswer" asp-items="Html.GetEnumSelectList<Hal_Taalam.Enums.CorrectAnswerOption>()" class="form-control" required>
                            <option value="" disabled selected>-- @localizer["SelectCorrectAnswer"] --</option>
                        </select>
                    </div>
                </div>

                <div class="form-col">
                    <div class="form-group">
                        <label class="form-label">@localizer["Level"]</label>
                        <select asp-for="Level" asp-items="Html.GetEnumSelectList<Hal_Taalam.Enums.QuestionLevel>()" class="form-control" required>
                            <option value="" disabled selected>-- @localizer["SelectLevel"] --</option>
                        </select>
                    </div>
                </div>

                <div class="form-col">
                    <div class="form-group">
                        <label class="form-label">@localizer["Category"]</label>
                        <select asp-for="Category" asp-items="Html.GetEnumSelectList<Hal_Taalam.Enums.CategoryOption>()" class="form-control" required>
                            <option value="" disabled selected>-- @localizer["SelectCategory"] --</option>
                        </select>
                    </div>
                </div>
            </div>

            <div style="margin-top: 30px; text-align: right;">
                <button type="submit" class="btn btn-primary" style="padding: 12px 30px; font-size: 1.1em;">
                    @(isEditMode ? "🆙 " + localizer["UpdateQuestionBtn"].Value : "💾 " + localizer["SaveQuestionBtn"].Value)
                </button>
            </div>
        </form>
    </div>
</div>
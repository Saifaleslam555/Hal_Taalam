@model IEnumerable<Hal_Taalam.ViewModel.Admin.QuestionListVM>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SharedResource> localizer

@{
    ViewData["Title"] = localizer["ManageQuestions"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/AdminQuestions.css" asp-append-version="true">
}

<div class="questions-container">
    <div class="admin-card">
        <div class="card-header-flex">
            <div>
                <h2 class="card-title">@localizer["ManageQuestions"]</h2>
                <p style="color: var(--text-muted); margin-top: 5px;">@localizer["ManageQuestionsDesc"]</p>
            </div>
            <div>
                <a asp-action="AddQuestion" class="btn btn-primary">
                    <span>➕</span> @localizer["AddNewQuestionBtn"]
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>@localizer["TableID"]</th>
                        <th>@localizer["TableQuestion"]</th>
                        <th>@localizer["TableCategory"]</th>
                        <th>@localizer["TableLevel"]</th>
                        <th>@localizer["TableActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td style="color: var(--text-dark); font-weight: 500;">@item.QuestionText</td>
                                <td>@item.CategoryID</td>
                                <td>
                                    <span style="background-color: var(--bg-cream); padding: 4px 8px; border-radius: 4px; color: var(--primary-orange); font-size: 0.9em;">
                                        @localizer["Level"] @item.Level
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="UpdateQuestion" asp-route-id="@item.Id" class="btn btn-outline" style="padding: 6px 12px; font-size: 0.9em; text-decoration: none; display: inline-block;">
                                        ✏️ @localizer["EditBtn"]
                                    </a>

                                    <form asp-action="DeleteQuestion" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-danger" style="padding: 6px 12px; font-size: 0.9em;"
                                                onclick="return confirm('هل أنت متأكد من حذف هذا السؤال؟')">
                                            🗑️ @localizer["DeleteBtn"]
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 30px;">@localizer["NoQuestionsAdded"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @* مش محتاجين AdminQuestions.js إلا لو عندك فيه وظائف تانية غير المودال *@
    <script src="~/js/AdminQuestions.js" asp-append-version="true"></script>
}
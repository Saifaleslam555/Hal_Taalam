@model IEnumerable<Hal_Taalam.ViewModel.Admin.QuestionListVM>

@{
    ViewData["Title"] = localizer["ManageQuestions"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/AdminQuestions.css" asp-append-version="true">
}

<div class="questions-container">
    <div class="admin-card">
        <div class="card-header-flex">
            <div>
                <h2 class="card-title">@localizer["ManageQuestions"]</h2>
                <p style="color: var(--text-muted); margin-top: 5px;">@localizer["ManageQuestionsDesc"]</p>
            </div>
            <div>
                <a asp-action="AddQuestion" class="btn btn-primary">
                    <span>➕</span> @localizer["AddNewQuestionBtn"]
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>@localizer["TableID"]</th>
                        <th>@localizer["TableQuestion"]</th>
                        <th>@localizer["TableCategory"]</th>
                        <th>@localizer["TableLevel"]</th>
                        <th>@localizer["TableActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td style="color: var(--text-dark); font-weight: 500;">@item.QuestionText</td>
                                <td>@item.CategoryID</td>
                                <td><span style="background-color: var(--bg-cream); padding: 4px 8px; border-radius: 4px; color: var(--primary-orange); font-size: 0.9em;">@localizer["Level"] @item.Level</span></td>
                                <td>
                                    <button class="btn btn-outline" style="padding: 6px 12px; font-size: 0.9em;"
                                            data-id="@item.Id"
                                            data-question="@item.QuestionText"
                                            data-a1="@item.Answer1"
                                            data-a2="@item.Answer2"
                                            data-a3="@item.Answer3"
                                            data-a4="@item.Answer4"
                                            data-correct="@item.CorrectAnswer"
                                            data-category="@item.CategoryID"
                                            data-level="@item.Level"
                                            onclick="openEditModal(this)">
                                        ✏️ @localizer["EditBtn"]
                                    </button>

                                    <button onclick="confirmDelete(@item.Id)" class="btn btn-danger" style="padding: 6px 12px; font-size: 0.9em;">🗑️ @localizer["DeleteBtn"]</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 30px;">@localizer["NoQuestionsAdded"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="questionModal" class="modal-overlay">
    <div class="modal-content">
        <span class="close-modal" onclick="closeModal()">&times;</span>
        <h2 id="modalTitle" class="card-title mb-4" style="margin-bottom: 20px;">@localizer["AddNewQuestionBtn"]</h2>

        <form id="questionForm" method="post" action="/Admin/CreateQuestion">
            <input type="hidden" id="QuestionId" name="QuestionId" value="0" />

            <div class="form-group">
                <label class="form-label">@localizer["QuestionText"]</label>
                <textarea id="QuestionText" name="Question" class="form-control" rows="2" required></textarea>
            </div>

            <div style="margin-top: 20px; text-align: right;">
                <button type="button" class="btn btn-outline" onclick="closeModal()">@localizer["CancelBtn"]</button>
                <button type="submit" class="btn btn-primary" id="btnSubmit">💾 @localizer["SaveQuestionBtn"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/AdminQuestions.js" asp-append-version="true"></script>
}
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hal Taalam</title>
    <link rel="stylesheet" href="~/css/Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Hal_Taalam.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar">
        <!-- Logo Section -->
        <div class="nav-logo">
            <img src="~/Image/logo.jpg" alt="Hal Taalam Logo" />
            <div class="game-title">Hal Taalam</div>
        </div>

        <!-- Center Navigation -->
       @*  <div class="nav-center">
            <a asp-controller="GameMenu" asp-action="HowToPlay" class="nav-btn nav-btn-help">❓ How To Play</a>
            <a asp-controller="GameMenu" asp-action="Leaderboard" class="nav-btn nav-btn-leaderboard">🏆 Leaderboard</a>
        </div> *@

        <!-- Right Side - Player Info & Auth -->
        <div class="nav-right">
            
                <!-- Player Info (for logged in users) -->
                <div class="player-nav-info" id="playerNavInfo" style="display: none;">
                    <div class="player-nav-avatar" id="playerNavAvatar" >
                    <img src="~/Image/default-avatar.jpg" alt="Avatar" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
                </div>
                <div class="player-nav-details">
                    <div class="player-nav-name" id="playerNavName" ></div>
                    <div class="player-nav-level">Level <span id="playerNavLevel"></span></div>
                    <div class="player-nav-xp">
                        <div class="player-nav-xp-fill" id="playerNavXpFill">not done </div>
                    </div>
                </div>
                <div class="auth-buttons">
                    <a asp-controller="Auth" asp-action="Logout" class="nav-btn btn-signout">Sign Out</a>
                </div>
            </div>
            
            <!-- Guest Info & Auth Buttons (for guests) -->
            <div class="guest-nav-info player-nav-info" id="guestNavInfo">
                <div class="player-nav-avatar guest-nav-avatar">👤</div>
                <div class="player-nav-details">
                    <div class="player-nav-name">Guest</div>
                    <div class="player-nav-level">Level 1</div>
                    <div class="player-nav-xp">
                        <div class="player-nav-xp-fill" style="width: 0%;"></div>
                    </div>
                </div>
                <div class="auth-buttons">
                    <a asp-controller="Auth" asp-action="Login" class="nav-btn btn-login">Login</a>
                    <a asp-controller="Auth" asp-action="Register" class="nav-btn btn-signup">Sign Up</a>
                </div>
            </div>
        </div>
        
    </nav>

    <!-- Main Content Area -->
    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <!-- Footer (optional) -->
    <footer class="footer">
        <div class="footer-content">
            &copy; 2025 - Hal Taalam - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/js/Layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
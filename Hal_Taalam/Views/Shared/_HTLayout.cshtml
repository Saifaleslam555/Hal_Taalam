@using Microsoft.AspNetCore.Identity
@using Hal_Taalam.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hal Taalam</title>

    <link rel="stylesheet" href="~/css/Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Hal_Taalam.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar">
        <div class="nav-logo">
            <img src="~/Image/logo.jpg" alt="Hal Taalam Logo" />
            <div class="game-title">Hal Taalam</div>
        </div>

        <div class="nav-right">
            @if (SignInManager.IsSignedIn(User))
            {
                <div class="player-nav-info">
                    <div class="player-nav-avatar">
                        <img src="~/Image/default-avatar.jpg" alt="Avatar" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;" />
                    </div>
                    <div class="player-nav-details">
                        <div class="player-nav-name">@User.Identity.Name</div>
                    </div>
                    <div class="auth-buttons">
                        <form asp-controller="Account" asp-action="SignOut" method="post">
                            <button type="submit" class="nav-btn btn-signout" style="border:none; cursor:pointer;">Sign Out</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="guest-nav-info player-nav-info">
                    <div class="player-nav-avatar guest-nav-avatar">👤</div>
                    <div class="player-nav-details">
                        <div class="player-nav-name">Guest</div>
                    </div>
                    <div class="auth-buttons">
                        <a asp-controller="Account" asp-action="Login" class="nav-btn btn-login">Login</a>
                        <a asp-controller="Account" asp-action="Register" class="nav-btn btn-signup">Sign Up</a>
                    </div>
                </div>
            }
        </div>
    </nav>

    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-content">
            &copy; 2025 - Hal Taalam - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/js/Layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>